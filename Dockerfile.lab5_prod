# LAB-5 PRODUCTION TDA DOCKER ENVIRONMENT
# Freezes homological solver versions and dependencies for absolute scientific reproducibility.

FROM python:3.12-slim

WORKDIR /app

# System dependencies for TDA and C++ compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

# Pinned Python Dependencies for TDA & Data Ingestion
RUN pip install --no-cache-dir \
    numpy==1.26.4 \
    scipy==1.12.0 \
    matplotlib==3.8.3 \
    ripser==0.6.15 \
    persim==0.3.8 \
    scikit-learn==1.4.1.post1 \
    giotto-tda==0.6.2 \
    h5py==3.10.0 \
    requests==2.31.0

COPY . /app

CMD ["python3", "scripts/lab5_prod_pipeline.py"]
